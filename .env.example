# Smart LMS Dashboard - environment template
# Analytics warehouse DB (used by ETL load and shared defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analytics_db
DB_USER=change_me
DB_PASSWORD=change_me

# Moodle/source DB (used by moodle extraction)
# SOURCE_DB_* is supported as alias of MOODLE_DB_*
MOODLE_DB_HOST=127.0.0.1
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=change_me
MOODLE_DB_PASSWORD=change_me

SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=moodle
SOURCE_DB_USER=change_me
SOURCE_DB_PASSWORD=change_me

# ML DB (optional override; falls back to DB_* when omitted)
ML_DB_HOST=127.0.0.1
ML_DB_PORT=3306
ML_DB_NAME=ml_db
ML_DB_USER=change_me
ML_DB_PASSWORD=change_me

# Runtime defaults
DATA_SOURCE=historical
REFRESH_STAGING=0